# === YOUTUBE API ===
# Required for fetching latest videos and playlists across the site.
# Obtain this from the Google Cloud Console with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# === EMAIL (Resend) ===
# Required for the contact form endpoint (/api/contact) to send emails.
# Obtain this from resend.com
RESEND_API_KEY=
