# === SESSION SECRETS (REQUIRED) ===
# Must be at least 32 characters each. Generate with: openssl rand -base64 32
# These are SEPARATE secrets — do NOT share the same value between admin and user.
ADMIN_SESSION_SECRET=
USER_SESSION_SECRET=

# === ADMIN ===
# Pre-computed bcrypt hash for the admin password.
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-strong-password', 10))"
ADMIN_PASSWORD_HASH=

# === CLOUDFLARE R2 ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# === EMAIL (Resend) ===
RESEND_API_KEY=
EMAIL_FROM=VerspeKtive <noreply@verspektive.com>
